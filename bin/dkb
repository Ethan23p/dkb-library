#!/usr/bin/env bash
# dkb — the Epistack engine, on PATH.
#
# Claude Code adds a plugin's bin/ directory to the Bash tool's PATH while the
# plugin is enabled, so this file is what turns the canonical invocation
# (`bun engines/epistack/main.ts …`) into a bare `dkb …` command.
#
# CLAUDE_PLUGIN_ROOT is set by Claude Code; the fallback resolves the repo from
# this script's own location so the wrapper also works from a plain git clone.
set -euo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
ENTRY="$PLUGIN_ROOT/engines/epistack/main.ts"

if ! command -v bun >/dev/null 2>&1; then
  echo "error: 'bun' is not installed or not on PATH" >&2
  echo "next: install Bun (https://bun.sh), then re-run this command" >&2
  exit 3
fi

if [ ! -f "$ENTRY" ]; then
  echo "error: engine entry point not found at $ENTRY" >&2
  echo "next: reinstall the dkb plugin, or run from a complete clone of the repository" >&2
  exit 3
fi

exec bun "$ENTRY" "$@"
